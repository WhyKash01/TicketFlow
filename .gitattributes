# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Windows batch files must preserve CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must have LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary

