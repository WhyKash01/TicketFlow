# ==============================================================================
# TicketFlow - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in or override your local / production secrets.
# 3. DO NOT commit actual '.env' files containing real secrets to GitHub!
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ticketflow_user
POSTGRES_PASSWORD=ticketflow_pass
POSTGRES_DB=ticketflow_catalog

# Individual service datasource URLs (defaults shown)
SPRING_DATASOURCE_USERNAME=ticketflow_user
SPRING_DATASOURCE_PASSWORD=ticketflow_pass
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/ticketflow_catalog
BOOKING_DB_URL=jdbc:postgresql://localhost:5432/ticketflow_booking
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/ticketflow_payment
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/ticketflow_notification

# --- Redis Cache & Distributed Lock ---
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# --- RabbitMQ Message Broker ---
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- Internal Microservice Endpoints (Used by API Gateway) ---
CATALOG_SERVICE_URL=http://localhost:8081
BOOKING_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084

# --- API Gateway Port ---
GATEWAY_PORT=8080

# --- Frontend (Vite) ---
# When running Vite locally, leave as /api to leverage the Vite dev-server proxy
VITE_API_BASE_URL=/api

